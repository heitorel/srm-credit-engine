# =========================================================
# SRM Credit Engine - Environment Example
# =========================================================
# Copy this file to .env for local development.
#
# Do not commit real secrets.
# This file contains only safe example values.
# =========================================================

# =========================================================
# Project
# =========================================================

COMPOSE_PROJECT_NAME=srm-credit-engine
APP_ENV=local

# =========================================================
# Backend - Spring Boot
# =========================================================

BACKEND_PORT=8080

SPRING_PROFILES_ACTIVE=local

# JDBC connection used by the backend container.
# When running through Docker Compose, use the database service name as host.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/srm_credit_engine?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=srm_app
SPRING_DATASOURCE_PASSWORD=srm_app_password

# Optional local JDBC URL for running backend directly from the host machine.
LOCAL_SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/srm_credit_engine?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Flyway
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO

# OpenAPI / Swagger
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true

# =========================================================
# Database - MySQL
# =========================================================

MYSQL_PORT=3306
MYSQL_DATABASE=srm_credit_engine
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=srm_app
MYSQL_PASSWORD=srm_app_password

# =========================================================
# Frontend - Angular
# =========================================================

FRONTEND_PORT=4200

# URL used by the Angular application to call the backend.
# For browser access during local development, localhost is expected.
ANGULAR_API_BASE_URL=http://localhost:8080/api

# =========================================================
# CORS
# =========================================================

CORS_ALLOWED_ORIGINS=http://localhost:4200

# =========================================================
# Financial Defaults for Local Development
# =========================================================
# These are development defaults only.
# Business rules must remain implemented in backend/domain code
# and persisted where required.

DEFAULT_BASE_RATE=0.01000000

SUPPORTED_CURRENCIES=BRL,USD

# =========================================================
# Docker
# =========================================================

MYSQL_CONTAINER_NAME=srm-credit-engine-mysql
BACKEND_CONTAINER_NAME=srm-credit-engine-backend
FRONTEND_CONTAINER_NAME=srm-credit-engine-frontend

# =========================================================
# Testcontainers
# =========================================================
# Usually not required, but available for environments where Ryuk must be disabled.

TESTCONTAINERS_RYUK_DISABLED=false
